{
  "name": "portalpilot",
  "version": "0.1.0",
  "private": true,
  "description": "Local CSV/XLSX workflow automation with Playwright",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsx watch src/server/index.ts\"",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && vite build",
    "test": "vitest run --pool=forks --maxWorkers=1 --minWorkers=1",
    "test:watch": "vitest",
    "demo:record": "tsx scripts/record-demo.ts",
    "generate:example": "tsx scripts/generate-example.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "playwright": "^1.49.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.11",
    "vitest": "^2.1.8"
  }
}
